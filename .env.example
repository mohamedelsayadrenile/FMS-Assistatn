# LLM
LLM_BASE_URL=http://localhost:5000/v1
LLM_MODEL=openai/cyankiwi/Qwen3.6-27B-AWQ-INT4
LLM_API_KEY="None"

# FMS API
CREATE_SITE_URL=https://agridafter.com/api/sites
GET_SITES_URL=https://agridafter.com/api/sites
CREATE_FARM_URL_TEMPLATE=https://agridafter.com/api/sites/{siteId}/farms
CREATE_TASK_URL=https://agridafter.com/api/task-types

# Application
DEFAULT_TIMEZONE=Africa/Cairo
API_TIMEOUT_SECONDS=30

# Conversation Memory
REDIS_URL=redis://localhost:6379/0
CONVERSATION_MEMORY_LIMIT=10
CONVERSATION_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json